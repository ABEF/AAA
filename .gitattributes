# Preserve native review evidence bytes and Windows line endings.
reports/website-alignment/** -text whitespace=cr-at-eol
# Formatted native diagnostics contain intentional trailing spacing.
reports/website-alignment/*.log whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
# Preserve intentional spacing in the current compiler diagnostic log.
reports/artwork-palettes/forge-build-sizes.log whitespace=-blank-at-eol,-blank-at-eof
# Preserve the native Windows independent-model receipt bytes.
reports/artwork-palette/independent-draw-model.json -text whitespace=cr-at-eol
# The generated Solidity catalogue pins these exact JSON bytes on every OS.
design/nft-metadata/palette-system-v1/*.json text eol=lf
