pragma solidity 0.8.26;
import {BaselineHost,FusedHost} from "../src/LPFusionHosts.sol";
interface Vm {function expectRevert(bytes4)external;function store(address,bytes32,bytes32)external;function readFileBinary(string calldata)external view returns(bytes memory);function record()external;function accesses(address)external returns(bytes32[] memory,bytes32[] memory);function coolSlot(address,bytes32)external;function cool(address)external;}
contract LPFusionEngineeringTest {
 Vm constant vm=Vm(address(uint160(uint256(keccak256("hevm cheat code")))));
 BaselineHost a; FusedHost b;
 event EngineeringGas(string tree,uint256 baseline,uint256 fused,uint256 saving);
 uint256[8] ids=[uint256(1),2,17,128,513,700,999,1000];
 function setUp()public{a=new BaselineHost();b=new FusedHost();}
 function _set(uint256 o,uint256 w)internal{require(a.setWeight(o,w)==b.setWeight(o,w),"weight total");}
 function _credit(uint8 z,uint256 n)internal{a.credit(z,n);b.credit(z,n);}
 function _take(uint8 z,uint256 o)internal{require(a.take(z,o)==b.take(z,o),"take");}
 function _equal()internal view{require(a.digest()==b.digest(),"raw digest");for(uint8 z;z<2;++z){require(a.outstanding(z)==b.outstanding(z),"liability");for(uint256 i;i<ids.length;++i)require(a.claimable(z,ids[i])==b.claimable(z,ids[i]),"claimable");}}
 function testFusedMutableStateAndClaims()public{for(uint256 i;i<ids.length;++i)_set(ids[i],17+i*i);_credit(0,791);_credit(1,4999);for(uint256 i;i<24;++i){uint256 o=ids[i%8];_set(o,i%5==0?0:11+i*3);if(i%3==0)_take(uint8(i%2),ids[(i+5)%8]);_credit(uint8(i%2),i+1);_equal();}for(uint8 z;z<2;++z)for(uint256 i;i<ids.length;++i)_take(z,ids[i]);_equal();require(a.outstanding(0)==0&&a.outstanding(1)==0,"drain");}
 function testFusedMaximumZeroNoopOverflow()public{_set(1,type(uint256).max-3);_set(1000,3);_credit(0,type(uint256).max);_credit(1,type(uint256).max);_set(1,type(uint256).max-3);_equal();vm.expectRevert(bytes4(0x4e487b71));a.setWeight(1,type(uint256).max);vm.expectRevert(bytes4(0x4e487b71));b.setWeight(1,type(uint256).max);_equal();_set(1,type(uint256).max-4);_equal();_set(1000,0);_equal();_set(1,0);_equal();vm.expectRevert(bytes4(keccak256("EmptyCohort()")));a.credit(0,1);vm.expectRevert(bytes4(keccak256("EmptyCohort()")));b.credit(0,1);_equal();for(uint8 z;z<2;++z){_take(z,1);_take(z,1000);}require(a.outstanding(0)==0&&a.outstanding(1)==0,"max drain");_set(1000,type(uint256).max);_credit(0,type(uint256).max);_take(0,1000);_equal();}
 function testFusedPhasesRemovalAndInvalidOrdinal()public{for(uint256 i;i<ids.length;++i)_set(ids[i],(uint256(1)<<128)+i*17+1);for(uint256 i;i<37;++i){_credit(uint8(i%2),1+i%3);if(i%4==0)_take(uint8(i%2),ids[i%8]);}_equal();for(uint256 i;i<ids.length;++i){_set(ids[i],0);_equal();}_set(513,7);_set(1,3);_credit(0,1009);_credit(1,999);_equal();vm.expectRevert(bytes4(keccak256("InvalidOrdinal()")));a.setWeight(0,1);vm.expectRevert(bytes4(keccak256("InvalidOrdinal()")));b.setWeight(0,1);vm.expectRevert(bytes4(keccak256("InvalidOrdinal()")));a.setWeight(1001,1);vm.expectRevert(bytes4(keccak256("InvalidOrdinal()")));b.setWeight(1001,1);_equal();}
 function testFusedDeterministicAdversarialSequence()public{uint256 seed=672187;for(uint256 i;i<ids.length;++i)_set(ids[i],1+i);for(uint256 i;i<128;++i){seed=uint256(keccak256(abi.encode(seed,i)));uint256 o=ids[seed%8];uint8 z=uint8(seed>>16)%2;uint256 op=(seed>>32)%4;if(op==0)_set(o,(seed>>64)%1e30);else if(op==1)_credit(z,(seed>>80)%1e22);else if(op==2)_take(z,o);else{uint256 w=a.weightOf(o);_set(o,w);}if(i%8==0)_equal();}_equal();for(uint8 z;z<2;++z)for(uint256 i;i<ids.length;++i)_take(z,ids[i]);_equal();require(a.outstanding(0)==0&&a.outstanding(1)==0,"sequence drain");}
 function _load(address host,string memory label)internal{bytes memory data=vm.readFileBinary(string.concat("fixtures/",label,".bin"));require(data.length%64==0,"fixture");for(uint256 i;i<data.length;i+=64){bytes32 slot;bytes32 value;assembly{slot:=mload(add(add(data,32),i)) value:=mload(add(add(data,64),i))}vm.store(host,slot,value);}}
 function _cool(address host)internal{vm.record();(bool ok,)=host.staticcall(abi.encodeWithSignature("digest()"));require(ok,"digest read");(bytes32[] memory reads,bytes32[] memory writes)=vm.accesses(host);for(uint256 i;i<reads.length;++i)vm.coolSlot(host,reads[i]);for(uint256 i;i<writes.length;++i)vm.coolSlot(host,writes[i]);vm.cool(host);}
 function testFusedColdExtractedOwnerAndCollective()public{_load(address(a),"owner");_load(address(b),"owner");_equal();_cool(address(a));uint256 g=gasleft();a.setWeight(1000,99909134925785758152);uint256 oldGas=g-gasleft();_cool(address(b));g=gasleft();b.setWeight(1000,99909134925785758152);uint256 newGas=g-gasleft();emit EngineeringGas("actual999owner",oldGas,newGas,oldGas-newGas);_equal();BaselineHost c=new BaselineHost();FusedHost d=new FusedHost();_load(address(c),"collective");_load(address(d),"collective");require(c.digest()==d.digest(),"collective import");_cool(address(c));g=gasleft();c.setWeight(1000,1);oldGas=g-gasleft();_cool(address(d));g=gasleft();d.setWeight(1000,1);newGas=g-gasleft();emit EngineeringGas("actual999collective",oldGas,newGas,oldGas-newGas);require(c.digest()==d.digest(),"collective final");}
}
