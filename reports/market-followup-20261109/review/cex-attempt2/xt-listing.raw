<script>
  setTimeout(() => {
  	var params = {};
    location.search.substr(1).split('&').forEach(item => {
        var [k, v] = item.split('=');
        k && v && (params[k] = v);
    });
    Object.keys(params).length && console.log(params);
    (function() {
      var votedSize = +(document.querySelector('.article-votes-count')?.innerText.match(/(\d+)/g).pop()) || 0;
      var targetSize = +(document.querySelector('#voteSize')?.innerText) || 0;
      var voteButton = document.querySelector('.article-vote-up');
      var event = new MouseEvent('click', { view: window, bubbles: true, cancelable: true });

      if (votedSize >= targetSize || voteButton?.classList.contains('button-primary')) return;

      fetch('/hc/api/internal/csrf_token.json').then(r => r.json()).then(res => {
        var csrfToken = res.current_session.csrf_token;
        var articleId = location.href.match(/\d+/);
        var lang = location.href.match(/hc\/(.*)?\/articles/)?.[1];
        var postForm = new FormData();
        postForm.append('value', 'up');
        fetch(`/hc/${lang}/articles/${articleId}/vote`, { headers: { "X-Csrf-Token": csrfToken }, body: postForm, method: "POST", }).then((res) => console.log(`Vote result:`, new Date, res.ok));
      });
    })();
  	(function() {
			var urlRefCode = params.ref;
      var joinNowATag = document.querySelector("a[href*='/activity-registration?activityId=']");
      if (urlRefCode && joinNowATag) {
        joinNowATag.setAttribute('href', joinNowATag.href + '&ref=' + urlRefCode);
			}
  	})();
  }, 0);
</script>

