              function completeAvatarUrl(path) {
                var repositoryPath = path.replace(
                  new RegExp('^https?://(jia|jic|jid|jib)[.][a-zA-Z0-9_-]+[.](com|world)/'),
                  '/'
                );
                let avatarUrl = repositoryPath.startsWith('/imageRepository/')
                  ? '/static-old-backend' + repositoryPath
                  : path;
                if (repositoryPath.startsWith('/image/')) {
                  avatarUrl = '/static-nasbak-backend' + repositoryPath;
                }
                return /[.]svg($|[?#])/i.test(avatarUrl)
                  ? avatarUrl
                  : avatarUrl + '?x-oss-process=image/format,webp';
              }
              try {
                var container = document.currentScript.parentElement;
                var userInfo = JSON.parse(localStorage.getItem('userInfo') || '{}') || {};
                var image = document.createElement('img');
                image.style.display = 'none';
                image.onload = function () {
                  image.style.display = '';
                };
                image.onerror = function () {
                  image.remove();
                };
                var avatarUrl = completeAvatarUrl(userInfo.avatarUrlReview||userInfo.avatarUrl||'/static-client/assets/images/user.svg');
                image.src = false && avatarUrl.startsWith('/')
                  ? 'https://www.lbk.world' + avatarUrl
                  : avatarUrl;
                image.alt = 'Avatar';
                container.appendChild(image);
              } catch (_) {}
            })();</script></span></div><span class="index-module-scss-module__C-Cisq__ssr-menu" title="Menu" aria-label="Menu"><svg viewBox="0 0 20 20" aria-hidden="true"><path fill="currentColor" d="M3 9h13.3364v1.25H3zM3 4h13.3364v1.25H3zM3 13.875h13.3364v1.25H3z"></path></svg></span></div></header><!--$--><!--/$--></div><div class="support-layout internal-theme-layout" data-color-scheme="light"><style id="support-theme-global-style">
