mail?\",\"L0000066\":\"Verification code sent\",\"L0015115\":\"Network Error\",\"L0007997\":\"Funds password changed successfully\",\"L0011597\":\"Fund password setup successful.\",\"L0003911\":\"Modify asset password\",\"L0000288\":\"Set Your Fund Password\",\"L0000126\":\"Fund Password\",\"L0000454\":\"Please enter password\",\"L0007941\":\"Enter the password again\",\"L0001418\":\"The two passwords do not match.\",\"L0011599\":\"Fund Password Verification\",\"L0012274\":\"Once enabled, you will need to enter your fund password every 2 hours to verify your identity.\",\"L0007812\":\"8-20 characters\",\"L6665704\":\"Only letters and numbers are supported\",\"L0011187\":\"Email successfully linked\",\"L0003785\":\"You have completed email binding\",\"L0000111\":\"Email Binding\",\"L0000999\":\"Verify\",\"L0002198\":\"Settings\",\"L0000112\":\"Bind Google Auth\",\"L0012565\":\"Login verification enabled\",\"L0011965\":\"Funds password verification enabled\",\"L0012566\":\"Login verification disabled\",\"L0012567\":\"Fund password verification disabled\",\"L0012275\":\"Disable Google login strategy\",\"L0012276\":\"Disable fund password strategy\",\"L0006174\":\"Security policy modification\",\"L0007929\":\"Login verification\",\"L0011603\":\"Once enabled, you will need to enter your Google Authenticator code every time you log in.\",\"L0011635\":\"Phone number unbinding successful\",\"L0009950\":\"Unbind phone number\",\"L0011639\":\"Phone number changing successful\",\"L0011636\":\"Phone number binding successful\",\"L0000135\":\"Change Phone Number\",\"L0001950\":\"Phone\",\"L0014141\":\"New phone number\",\"L0015897\":\"Please confirm in your wallet\",\"L0016303\":\"Wallet address mismatch\",\"L0016304\":\"The current wallet address does not match the one used at registration. Please use {0} to proceed.\",\"L0015896\":\"Signature has been canceled\",\"L0015895\":\"Please connect your wallet before proceeding\",\"L6663799\":\"Unable to change email. Please bind Google Authenticator, phone number, or a Passkey first.\",\"L0009321\":\"Network Error\",\"L0005563\":\"Frequent operation. Please try again later\",\"L6663790\":\"To ensure account security, you have reached the daily limit for liveness verification (3 attempts). Please try again tomorrow.\",\"L6663795\":\"Security Verification Failed\",\"L6663798\":\"Fill out the form\",\"L6663796\":\"Your account does not currently have sufficient security verification methods to complete this operation online.\",\"L6663797\":\"Please fill out the following form. Customer service will review your request within 1 business day after submission.\",\"L0011683\":\"Security Alert\",\"L6663789\":\"For the security of your assets, withdrawals and fiat trading will be disabled for 24 hours after changing your email address.\",\"L6664975\":\"To ensure the security of your assets, withdrawals and fiat trading will be unavailable for 24 hours after you modify your Google Authenticator.\",\"L6663915\":\"Can you still receive verification codes at this email address?\",\"L6663919\":\"Can you still use this Google Authenticator?\",\"L6663792\":\"Use the current address for identity verification\",\"L6663920\":\"Use current Google Authenticator for verification\",\"L0022397\":\"Yes\",\"L6663793\":\"No\",\"L6663794\":\"Use other verification methods\",\"L6664024\":\"Email address updated successfully\",\"L6663800\":\"Change Email\",\"L6663801\":\"New Email\",\"L0000055\":\"Please enter email code\",\"L0000117\":\"Please enter an email address\",\"L6663908\":\"Discard this setup?\",\"L6663910\":\"Discard\",\"L6663911\":\"Continue binding\",\"L6663909\":\"The information you've entered hasn't been saved. If you discard it, you will need to start over.\",\"L0003051\":\"Please enter SMS code\",\"L0005056\":\"Please enter Google Auth code\",\"L6663912\":\"Please verify your passkey\",\"L6663913\":\"Verification successful\",\"L0009322\":\"Verification in progress\",\"L6663914\":\"Unverified\",\"L0019126