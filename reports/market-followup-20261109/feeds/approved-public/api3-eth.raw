    <link rel="manifest" href="/manifest.json" />
    <title>API3 Market</title>
    <style type="text/css">
      body {
        background-color: #111648;
        margin: 0;
      }

      .loading-cube {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        height: 750px;
        z-index: -1;
      }

      .loading-screen {
        padding: 18px 0 0 16px;
      }

      .loading-screen img.api3-market-desktop-logo {
        display: none;
      }

      @media (min-width: 600px) {
        .loading-cube {
          height: min(min(110vh, 110vw), 1000px);
        }
      }

      @media (min-width: 1200px) {
        .loading-screen {
          padding: 32px 0 0 40px;
        }

        .loading-screen img.api3-market-mobile-logo {
          display: none;
        }

        .loading-screen img.api3-market-desktop-logo {
          display: block;
        }
      }
    </style>
    <script type="module" crossorigin src="/assets/index-Cd5M3xxk.js"></script>
    <link rel="modulepreload" crossorigin href="/assets/api3-B0P4kasb.js">
    <link rel="modulepreload" crossorigin href="/assets/feed-backgrounds-ixlJPhsX.js">
    <link rel="modulepreload" crossorigin href="/assets/syntax-highlighting-DnW-D5Wz.js">
    <link rel="stylesheet" crossorigin href="/assets/index-2Lr54BdC.css">
  </head>
  <body>
    <div id="root"></div>
    <div id="modal"></div>
    <!-- Loading screen is being displayed while bundle is loading and hidden in the useLoader after the page is loaded  -->
    <div class="loading-screen" data-testid="loading-screen">
      <img src="/images/logo/secondary-dark-mobile.svg" alt="API3 Market logo" class="api3-market-mobile-logo" />
      <img src="/images/logo/primary-dark-desktop.svg" alt="API3 Market logo" class="api3-market-desktop-logo" />
      <object type="image/svg+xml" data="/images/loading.svg" aria-label="loading-graphic" class="loading-cube" />
    </div>
  </body>
