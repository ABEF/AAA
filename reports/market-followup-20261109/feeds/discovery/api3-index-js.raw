  ${PAe};

  padding-left: 0;
  padding-right: 0;

  .search-chain-box {
    width: 100%;
    margin-bottom: 32px;
    max-width: 328px;
  }

  &.scroll-direction-up,
  &.scroll-direction-down {
    .search-chain-box {
      margin-bottom: 16px;
    }
  }

  @media (min-width: ${D$}px) {
    .search-chain-box {
      max-width: 500px;
    }
  }

  @media (min-width: ${_e.sm}px) {
    .search-chain-box {
      .search-box-inner {
        padding: 16px 24px;

        input,
        input::placeholder {
          ${He.body[9]}
        }

        .search-box-icon {
          width: 20px;
          height: 20px;
        }
      }
    }
  }

  @media (min-width: ${_e.md}px) {
    flex-direction: row;
    margin-bottom: 32px;

    .select-chain-label-tablet {
      font-size: 22px;
      font-weight: 600;
      line-height: 130%;
      margin-bottom: 22px;
      order: 0;
      margin: 0;
    }

    .search-chain-box {
      order: 1;
      max-width: 400px;
      padding: 0;
      margin: 0 96px 0 auto;

      .search-box-inner {
        padding: 16px 16px 16px 24px;
        height: 64px;

        input,
        input::placeholder {
          ${He.body[6]}
        }
      }
    }

    .mainnet-testnet-toggle {
      order: 2;
      margin: 0;
    }
  }

  @media (min-width: ${_e.lg}px) {
    .search-chain-box {
      max-width: 443px;
    }
  }
