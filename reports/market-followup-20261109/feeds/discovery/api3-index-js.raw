    }

    .active-plans-grid {
      font-size: 16px;

      .grid-header-left,
      .grid-header-right {
        font-size: 14px;
      }

      .heartbeat-skeleton {
        height: 18px;
      }

      .deviation-skeleton {
        height: 18px;
        width: 110px;
      }

