  display: inline-flex;
  align-items: center;
  position: relative;
  justify-content: center;

  .expiring-icon {
    width: 16px;
    height: 16px;
    min-width: 16px;
  }

  .medium .expiring-icon {
    width: 18px;
    height: 18px;
    min-width: 18px;
  }

  .expiring-reminder-button {
    padding-left: 0;
    gap: 6px;
    white-space: nowrap;
  }

  @media (max-width: ${_e.sm}px) {
    [data-radix-popper-content-wrapper] {
      transform: none !important;
    }
  }

  @media (min-width: ${_e.sm}px) {
