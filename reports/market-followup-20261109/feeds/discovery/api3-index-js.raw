    padding: 8px 0;

    .account-address-text {
      padding-left: 8px;
      padding-right: 16px;
      color: var(--color-gray-300);
      font-size: 18px;
      line-height: 150%;
    }

    > button {
      padding: 0;
      height: 20px;
    }

    svg {
      width: 24px;
      height: 24px;
      color: var(--color-dark-blue-50);
    }
  }

  .wallet-details {
    width: 100%;
    background-color: var(--color-base-blue-ui);

    & > div {
      padding: 0;
      & > * {
        padding: 24px 0 24px 40px;
      }
      & > *:first-child {
        border-bottom: 1px solid var(--color-dark-blue-400);
      }
    }
  }
