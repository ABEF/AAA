  width: 100%;
  white-space: nowrap;
  position: relative;

  .dropdown-toggle {
    display: flex;
    align-items: center;
    cursor: pointer;
    padding: 0 26px 0 24px;
    height: 48px;
    border-radius: 32px;
    border-bottom: 1px solid transparent;
    background-color: var(--color-dark-blue-700);
    transition:
      background-color,
      border-bottom,
      border-radius 0.3s;
    transition-delay: 0.5s;

    .select-title {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      width: 100%;
      overflow: hidden;

      .chain-title {
        display: flex;
        align-items: baseline;
        gap: 8px;
        margin: 0 auto 0 8px;
      }

      .chain-name {
        ${He.body[9]}
        color: var(--color-base-light);
      }

      .chain-id {
        ${He.body[12]}
        color: var(--color-gray-400);
      }

      img {
        width: 20px;
        height: 20px;
      }

      svg {
        width: 13px;
        height: 13px;
        transition: var(--animation-flip-chevron);
      }
    }

    &.open {
      border-bottom: 1px solid var(--color-dark-blue-300);
      border-radius: 32px 32px 0 0;
      transition-delay: 0s;

      .select-title {
        svg {
          transform: rotate(180deg);
        }
      }
    }

    &.single-option {
      cursor: default;

      svg {
        display: none;
      }
    }
  }

  .dropdown-options {
    &.open {
      ul {
        max-height: 580px;
        transition-delay: 0.3s;
      }
    }

    ul {
      position: absolute;
      min-width: 100%;
      margin: 0;
      padding: 0;
      z-index: var(--z-index-dropdown);
      background-color: var(--color-dark-blue-700);
      border-radius: 0 0 6px 6px;
      transition: all 0.5s ease;
      transition-delay: 0s;
      max-height: 0px;
      overflow: hidden;

      &:empty {
        padding: 0;
      }

      li {
        display: flex;
        align-items: center;
        padding: 8px 18px;
        height: 52px;
        cursor: pointer;
        white-space: normal;
        border-bottom: 1px solid var(--color-dark-blue-500);

        &:last-child {
          border-bottom: none;
        }
      }

      .chain-element {
        img {
          width: 20px;
          height: 20px;
        }

        .chain-name {
          padding-left: 8px;
          color: var(--color-base-light);
          text-align: left;
          ${He.body[9]}
        }

        .chain-id {
          color: var(--color-gray-400);
          padding-left: 8px;
          text-align: left;
          ${He.body[12]}
        }

        svg {
          margin-left: auto;
          color: var(--color-action-success-500);
        }

        &:hover {
          background-color: var(--color-dark-blue-600);
        }
      }

      .view-all-chains {
        justify-content: center;
        padding: 6px 16px;

        a {
          ${AJ}
          text-decoration: none;
        }
      }
    }
  }

  @media (min-width: ${_e.md}px) {
    .dropdown-toggle {
      padding: 0 32px 0 24px;
      height: 64px;

      .select-title {
        img {
          width: 36px;
          height: 36px;
        }

        svg {
          width: 16px;
          height: 16px;
        }

        .chain-name,
        .chain-id {
          ${He.body[6]}
        }
      }
    }

    .dropdown-options ul {
      border-radius: 0 0 6px 6px;

      li {
        height: 58px;
        padding-left: 32px;

        &.chain-element {
          ${He.body[6]}

          img {
            width: 32px;
            height: 32px;
          }

          .check-icon {
            width: 16px;
            height: 16px;
          }
        }
      }
    }
  }
`,gOt=({onClick:t})=>{const e=["USDT/USD","ETH","Exchange Rate"];return P.jsx(yOt,{children:e.map((n,r)=>P.jsx(mOt,{"data-testid":"search-example-box",onClick:()=>{t(n)},children:P.jsxs("span",{className:"search-term",children:["”",n,"”"]})},r))})},mOt=Ge.div`
  padding: 4px 16px;
  border-radius: 16px;
