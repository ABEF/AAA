    @media (min-width: ${_e.lg}px) {
      padding: 0 16px !important;
    }

    &:first-of-type {
      padding-left: 0 !important;
    }

    &:after {
      content: '';
      border: 1px solid var(--color-neutral-gray7);
      border-width: 2px 2px 0 0;
      position: absolute;
      right: -1px;
      top: 20%;
      height: 70%;
    }

    &:last-child:after {
      border: none;
    }
  }
