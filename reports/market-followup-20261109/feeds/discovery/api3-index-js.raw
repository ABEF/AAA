    display: flex;
    align-items: center;
    font-weight: 300;
    font-size: 12px;
    line-height: 160%;
  }

  label .checkbox-label {
    display: inline-flex;
    align-items: center;
  }

  label input {
    appearance: none;
    height: 16px;
    width: 16px;
    background-color: transparent;
    border: 1px solid var(--color-neutral-gray6);
    border-radius: 1px;
    margin: 0;
    cursor: pointer;
  }

  label input:checked {
    background-color: white;
    border-color: white;
  }

  label input:checked::before {
