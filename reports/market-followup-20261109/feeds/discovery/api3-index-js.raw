      height: 24px;
    }

    .close-button {
      margin: -6px 0;
      width: 32px;
      height: 32px !important;
    }

    .text-container {
      flex-direction: row;
    }

    .message {
      ${He.body[8]};
    }

    .secondary-message {
      ${He.link[2]};
    }

    .close-button {
      margin: 0 -6px 0 0;
      width: 40px;
