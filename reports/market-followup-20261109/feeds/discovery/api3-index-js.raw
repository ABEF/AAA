  display: flex;
  flex-direction: column;
  gap: 56px;
  max-width: 312px;

  .modal-header {
    margin-top: 14px;
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 4px;

    > span {
      display: inline-block;
      text-align: center;
      white-space: nowrap;
      ${He.heading[9]};

      & .chain-name {
        ${He.subtitle[9]};
      }

      img {
        width: 24px;
        height: 24px;
        vertical-align: middle;
        margin: -3px 0 0 0.25ch;
      }
    }
  }

  .modal-description {
    color: var(--color-gray-200);
    ${He.body[9]};
    text-align: center;
    margin: 0;
  }

  .modal-actions {
    display: flex;
    flex-direction: column-reverse;
    gap: 24px;
    justify-content: center;

    > button {
      width: 100%;
    }
  }

  @media (min-width: ${_e.sm}px) {
    padding: 0;
    gap: 64px;
    max-width: 528px;
    margin: 0 64px;
    box-sizing: border-box;

    .modal-header {
      margin-top: 0;
      gap: 8px;

      > span {
        ${He.heading[6]};

        & .chain-name {
          ${He.subtitle[3]};
        }

        img {
          min-width: 40px;
          min-height: 40px;
        }
      }
    }

    .modal-description {
      ${He.description[3]};
    }

    .modal-actions {
      gap: 32px;

      > button {
        width: unset;
        white-space: nowrap;
      }
    }
  }
