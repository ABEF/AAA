  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;

  min-width: 360px;
  min-height: var(--footer-height-xs);
  padding: 40px 24px 24px 24px;

  @media (max-width: ${_e.xs}px) {
    min-width: unset;
  }

  @media (min-width: ${_e.sm}px) {
    min-height: var(--footer-height-sm);
  }

  @media (min-width: ${_e.md}px) {
    min-height: var(--footer-height-md);
    justify-content: end;
    padding: 40px 40px 32px 40px;
  }

  @media (min-width: ${_e.lg}px) {
    min-height: var(--footer-height-lg);
  }
`,KRt=Ge.div`
