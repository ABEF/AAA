    width: 428px;
    padding: 40px;

    .active-plans-grid {
      ${He.body[9]};

      .grid-header-left,
      .grid-header-right {
        ${He.body[12]};
      }

      .grid-item-right,
      .grid-item-left {
        padding: 24px 0;
        gap: 4px;
      }

      & .help-icon {
        margin-left: 2px;
      }
    }
  }

  @media (min-width: ${_e.md}px) {
    width: 344px;
    padding: 32px 16px;
    border-radius: 16px;

    h3 {
      ${He.heading[9]};
      margin-bottom: 32px;
    }

    .active-plans-grid {
      ${He.body[12]};

      margin-bottom: 8px;
    }
  }

  @media (min-width: ${_e.lg}px) {
