pragma solidity 0.8.26;
import {ZZZClaimRouter} from "../src/ZZZClaimRouter.sol";
contract WalletCalldataTest {
function testOneClaimMatchesSolidityAbiEncodeCall() public pure {
ZZZClaimRouter.Claim[] memory claims = new ZZZClaimRouter.Claim[](1);
claims[0] = ZZZClaimRouter.Claim(115792089237316195423570985008687907853269984665640564039457584007913129639935, address(uint160(103929005307927756724354605802047639613112342136)), false);
bytes memory compiled = abi.encodeCall(ZZZClaimRouter.claimBatch, (claims));
bytes memory python = hex"";
require(compiled.length == python.length, "encoded length differs");
require(keccak256(compiled) == keccak256(python), "encoded bytes differ");
}
function testMixedThreeMatchesSolidityAbiEncodeCall() public pure {
ZZZClaimRouter.Claim[] memory claims = new ZZZClaimRouter.Claim[](3);
claims[0] = ZZZClaimRouter.Claim(444, address(uint160(103929005307927756724354605802047639613112342136)), false);
claims[1] = ZZZClaimRouter.Claim(444, address(uint160(103929005307927756724354605802047639613112342136)), true);
claims[2] = ZZZClaimRouter.Claim(2, address(uint160(0)), true);
bytes memory compiled = abi.encodeCall(ZZZClaimRouter.claimBatch, (claims));
bytes memory python = hex"";
require(compiled.length == python.length, "encoded length differs");
require(keccak256(compiled) == keccak256(python), "encoded bytes differ");
}
