+            count = 1;
+        } else {
+            if (r.sourceToken0 != address(0) || r.sourceToken1 != address(0) || m.amount0 != 0 || m.amount1 != 0 ||
+                m.individual != 0 || m.collective != 0 || m.migrationId == bytes32(0)) revert InvalidAmount();
