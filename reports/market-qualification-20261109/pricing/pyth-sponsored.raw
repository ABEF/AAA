es gas costs. Adjust thresholds\\naccording to your product’s latency and cost requirements.\"}]}]]}]]}]\n88:[\"$\",\"$Lba\",null,{\"href\":\"#evm\",\"children\":\"EVM\"}]\n89:[\"$\",\"$Lba\",null,{\"href\":\"#solana\",\"children\":\"Solana\"}]\n8a:[\"$\",\"$Lba\",null,{\"href\":\"#fogo\",\"children\":\"Fogo\"}]\n8b:[\"$\",\"$Lba\",null,{\"href\":\"#sui\",\"children\":\"Sui\"}]\n8c:[\"$\",\"$Lba\",null,{\"href\":\"https://tally.so/r/nGz2jj\",\"children\":\"form\"}]\n8e:[\"$\",\"$Lba\",null,{\"href\":\"https://dev-forum.pyth.network/c/announcements/6\",\"children\":\"dev-forum\"}]\n8f:[\"$\",\"$Lba\",null,{\"href\":\"#run-price-pusher\",\"children\":\"here\"}]\n91:[\"$\",\"$Lba\",null,{\"href\":\"#ethereum-mainnet\",\"children\":\"Ethereum Mainnet\"}]\n92:[\"$\",\"$Lba\",null,{\"href\":\"#hyperevm-mainnet\",\"children\":\"HyperEVM Mainnet\"}]\n93:[\"$\",\"$Lba\",null,{\"href\":\"#monad-mainnet\",\"children\":\"Monad Mainnet\"}]\n94:[\"$\",\"$Lba\",null,{\"href\":\"#optimism-mainnet\",\"children\":\"Optimism Mainnet\"}]\n95:[\"$\",\"$Lba\",null,{\"href\":\"#soneium-mainnet\",\"children\":\"Soneium Mainnet\"}]\n"])</script><script>self.__next_f.push([1,"b4:[\"$\",\"$Lba\",null,{\"href\":\"/pro/use-prices-on-blockchain/solana#price-feed-accounts\",\"children\":\"Price Feed Accounts\"}]\nb5:[\"$\",\"$Lba\",null,{\"href\":\"/pro/contract-addresses#sui\",\"children\":\"Sui contract addresses\"}]\nb6:[\"$\",\"$Lba\",null,{\"href\":\"/pro/use-prices-on-blockchain/sui#move-from-the-original-package\",\"children\":\"Move from the Original Package\"}]\nb7:[\"$\",\"$Lba\",null,{\"href\":\"https://github.com/pyth-network/pyth-crosschain/tree/main/apps/price_pusher\",\"children\":\"Price Pusher\"}]\nb8:[\"$\",\"$Lba\",null,{\"href\":\"/pro/acquire-api-key\",\"children\":\"Pyth Pro API key\"}]\nb9:[\"$\",\"$Lba\",null,{\"href\":\"https://github.com/pyth-network/pyth-crosschain/commit/bab960de82fc881fd3c9397627d4e1831aeec934\",\"children\":\"Price Pusher v10.5.0\"}]\n"])</script></b