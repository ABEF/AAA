    },
    "keeper/health.py": {
      "review": "Complete local source, execution/confirmation metadata, timestamps/profile/runtime policy and allowlisted summaries. Missing first pending observations are distinct from present invalid proofs and never imply readiness.",
      "sha256": "dd25d2151295d09dcdebc4b0331b82c8d2b384a5501b49d0bfeb483d396b5c04"
    },
    "keeper/operation_review.py": {
      "review": "Read-only subclass forbids mutations and transaction recovery, pinned reads and bounded typed simulation. An unavailable/unclassified stage is not an exact diagnosis or authorization.",
      "sha256": "75f6fc17399ae28791f81d97d5afea2f98a3061662cbb6e9f072b562d6f72f48"
    },
    "keeper/ops.py": {
      "review": "Complete health/snapshot/preflight input and output review: bounded snapshot preserves legacy body; legacy snapshot is diagnostic rather than exact backup. Source hashes and health verdicts do not approve adoption.",
      "sha256": "da396ec9c65295fe540f9dc812a0612d8ed27f1ab677fd388b479e2f2372ad89"
    },
    "keeper/principal.py": {
      "review": "Current custody5 rejects keeper distribution; governance-only paths not exposed. Historical worker progress never marks failed receiver as paid.",
      "sha256": "b602340db5c7a52ad281c6b60885e2f74cc2708b731595fac5eeb9e026da6874"
    },
    "keeper/probe.py": {
      "review": "Actual bounded read-only/provider observations are not qualification/adoption; no public probing was run in this audit.",
      "sha256": "42142395fa2e43a6360644effdafab7e3be26b37b985a9bd3ae6fcd9d1374a10"
    },
    "keeper/rebalance_confirmation.py": {
      "review": "Same canonical snapshot/capability proof and strict sampled readiness; historical schedule readers keep explicit scope. No continuous observation is inferred.",
      "sha256": "6cc29d78aaf4c3804379e9b15d0ff177ff537da1158e66a3111ae2c85d6d317d"
    },
    "keeper/royalties.py": {
      "review": "Original-currency royalty4 disables conversion. LP native-v4 fixed-ZZZ conversion retains confirmed hash, captured route/floors and bounded prefix/nonce safeguards.",
      "sha256": "02e04783068eed60db827673c9c27d3a37175edd7dccfa5ddefb8b54c055904c"
    },
    "keeper/staging_observer.py": {
      "review": "Legacy fixed local Anvil export and coarse snapshot interface remains used by the forced monitor; not removed or adopted as current release.",
      "sha256": "f5f5e77aa62605aa54b326e88245ff5d9f8e14bf723dad359786e706cbc021ce"
    },
    "keeper/watchdog.py": {
      "review": "Only completed progress sends a pulse. No notification thread during DNS/body stalls; systemd/cgroup required. Remaining process creation/kernel boundaries retained.",
      "sha256": "59b4bb7783453a8f271fd5ab265fd5d2857d55096479be34f10ffe56c8408372"
    },
    "zzz_ops/state.py": {
      "review": "Strict finite/unique JSON, private atomic file then directory durability and same-inode advisory locks. Replace-before-directory-fsync failure may expose a new file; no old-file-survival guarantee.",
      "sha256": "78985688f9fc0cebf4aa5912b1401a338ac1e9ce21d8c787393e0e2d421976cf"
    }
  },
