                item=path.lstat();need(stat.S_ISREG(item.st_mode)and item.st_uid==65534 and stat.S_IMODE(item.st_mode)==0o600
                    and item.st_nlink==1 and item.st_size==0 and read(path)==b'','new_lock_metadata')
