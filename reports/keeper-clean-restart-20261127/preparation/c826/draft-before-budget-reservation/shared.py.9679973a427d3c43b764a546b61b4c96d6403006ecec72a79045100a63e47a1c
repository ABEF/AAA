def read(path,maximum=2097152):
    before=path.lstat();need(stat.S_ISREG(before.st_mode)and before.st_nlink==1 and before.st_uid in(0,65534)
        and not before.st_mode&0o022 and before.st_size<=maximum,'file_metadata')
    fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK|os.O_CLOEXEC)
    try:
        raw=bytearray()
        while True:
            part=os.read(fd,min(65536,maximum+1-len(raw)))
            if not part:break
            raw.extend(part);need(len(raw)<=maximum,'file_bound')
        key=lambda item:(item.st_dev,item.st_ino,item.st_uid,item.st_mode,item.st_nlink,item.st_size,item.st_mtime_ns)
        need(key(before)==key(os.fstat(fd))==key(path.lstat())and len(raw)==before.st_size,'file_changed')
        return bytes(raw)
    finally:os.close(fd)


def value(path,maximum=2097152):return json.loads(read(path,maximum))


def save(name,data,folder=OUT):
    need(re.fullmatch('[A-Z][A-Z0-9_-]*\\.json',name)is not None,'artifact_name')
    raw=enc(data);need(len(raw)<=2097152,'artifact_bound');path=folder/name
    fd=os.open(path,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600)
    with os.fdopen(fd,'wb')as stream:stream.write(raw);stream.flush();os.fsync(stream.fileno())
    return{'bytes':len(raw),'sha256':sha(raw)}


@contextlib.contextmanager
def budget():
