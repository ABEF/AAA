def encode(signature,*args):
    from zzz_ops.abi import calldata
    return calldata(signature,*args)


def call(address,signature,*args):
    raw=request('eth_call',[{'to':address,'data':encode(signature,*args)},'latest'])
    need(type(raw)is str and raw.startswith('0x')and(len(raw)-2)%64==0,'call_shape')
    return[int(raw[index:index+64],16)for index in range(2,len(raw),64)]


def one(address,signature,*args):
    row=call(address,signature,*args);need(len(row)==1,'one_word');return row[0]


