        and item.st_nlink==1 and stat.S_IMODE(item.st_mode)==0o600,'budget_lock')
    fd=os.open(path,os.O_RDWR|os.O_NOFOLLOW|os.O_CLOEXEC)
    try:
        fcntl.flock(fd,fcntl.LOCK_EX)
        state=value(SHARED/'BUDGET.json',65536)
        need(type(state['started_monotonic'])in(int,float)and time.monotonic()-state['started_monotonic']<900
            and type(state['RPC_requests'])is int and state['RPC_requests']<MAX_RPC,'shared_budget')
        state['RPC_requests']+=1
        try:yield state
        finally:
            raw=enc(state);need(len(raw)<=65536,'budget_bound')
            temp=SHARED/'BUDGET.partial';out=os.open(temp,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600)
            with os.fdopen(out,'wb')as stream:stream.write(raw);stream.flush();os.fsync(stream.fileno())
            os.replace(temp,SHARED/'BUDGET.json')
    finally:fcntl.flock(fd,fcntl.LOCK_UN);os.close(fd)


def request(method,params):
    need(method in READ_METHODS|SETUP_METHODS,'driver_method')
    with budget()as state:
        identifier=state['RPC_requests'];body=enc({'jsonrpc':'2.0','id':identifier,'method':method,'params':params})
        need(len(body)<=131072,'request_bound');connection=http.client.HTTPConnection('127.0.0.1',19626,timeout=15)
        try:
            connection.request('POST','/',body,{'Content-Type':'application/json'})
            response=connection.getresponse();need(response.status==200,'RPC_HTTP');raw=response.read(2097153)
            need(len(raw)<=2097152,'RPC_response_bound');answer=json.loads(raw)
            need(type(answer)is dict and answer.get('jsonrpc')=='2.0'and type(answer.get('id'))is int
                and answer['id']==identifier and('result'in answer)!=('error'in answer),'RPC_identity')
            need('error'not in answer,'RPC_refusal');return answer['result']
        finally:connection.close()


def command(argv,*,cwd=SOURCE,env=None,seconds=90,secret_output=False,allowed_codes=(0,)):
    child=owned=None;parts=[bytearray(),bytearray()];size=0;end=time.monotonic()+seconds
    try:
        child=subprocess.Popen(list(map(str,argv)),cwd=cwd,env=env or environment(),stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,stderr=subprocess.PIPE,start_new_session=True,close_fds=True);owned=child
        with selectors.DefaultSelector()as selector:
            for index,pipe in enumerate((child.stdout,child.stderr)):
                os.set_blocking(pipe.fileno(),False);selector.register(pipe,selectors.EVENT_READ,index)
            while selector.get_map():
                need(time.monotonic()<end,'command_deadline')
                for selected,_ in selector.select(min(.1,max(.001,end-time.monotonic()))):
                    raw=os.read(selected.fd,min(16384,65537-size))
                    if not raw:selector.unregister(selected.fileobj);continue
                    size+=len(raw);need(size<=65536,'command_output_bound')
                    if not secret_output:parts[selected.data].extend(raw)
        code=child.wait(timeout=max(.001,end-time.monotonic()));owned=None;need(code in allowed_codes,'command_exit')
        return code,bytes(parts[0]),bytes(parts[1])
    finally:
        try:
            if owned is not None:
                if owned.poll()is None:
                    try:os.killpg(owned.pid,signal.SIGKILL)
                    except ProcessLookupError:pass
                owned.wait(timeout=2)
        finally:
            if child is not None:child.stdout.close();child.stderr.close()


