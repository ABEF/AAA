[Unit]
Description=PoPL reviewed unsigned observation schedule

[Timer]
Unit=zzz-keeper-observer.service
# Deliberately invalid placeholders: production cadence is not selected.
OnActiveSec=__REVIEWED_INITIAL_DELAY__
OnUnitInactiveSec=__REVIEWED_OBSERVATION_INTERVAL__
AccuracySec=1s
RandomizedDelaySec=0

[Install]
WantedBy=timers.target
